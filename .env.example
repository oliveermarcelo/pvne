# Banco de dados
DATABASE_URL="postgresql://pvne:pvne@localhost:5547/pvne?schema=public"

# URL pública do site (usada em links de e-mail)
APP_URL="http://localhost:3000"

# Produção (Docker): domínios atendidos pelo Caddy com HTTPS automático, separados por vírgula.
# O DNS (registro A) de cada um precisa apontar para o IP da VPS.
SITE_DOMAINS="pvne.cards, www.pvne.cards"
# Senha do PostgreSQL do Docker (troque por uma senha forte na VPS)
POSTGRES_PASSWORD="troque-esta-senha"

# Segredo do endpoint de cron (/api/cron/auctions). Gere um valor aleatório longo.
CRON_SECRET="troque-por-um-valor-aleatorio"

# Onde as imagens enviadas são gravadas (volume no Docker)
UPLOAD_DIR="./storage/uploads"

# Documentos de vendedores e comprovantes (NUNCA dentro de uma pasta pública)
PRIVATE_UPLOAD_DIR="./storage/private"

# SMTP para recuperação de senha. Sem SMTP_HOST, o link é exibido no log do servidor.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PVNE Cards <nao-responda@pvnecards.com.br>"

# Credenciais do administrador criado pelo seed
SEED_ADMIN_EMAIL="admin@pvnecards.com.br"
SEED_ADMIN_PASSWORD="Admin@12345"

# Notificações push do app (PWA). Opcional: sem estas chaves o sistema gera um par
# na primeira vez e guarda no banco. Para fixar as suas: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contato do responsável pelo envio (mailto: ou https://). Padrão: APP_URL quando for https
VAPID_SUBJECT=""
